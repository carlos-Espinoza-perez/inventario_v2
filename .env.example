# Supabase Configuration
# ADVERTENCIA: este archivo se empaqueta dentro del APK (asset de Flutter).
# Solo valores publicables. NUNCA poner aquí service_role ni keys de pago.
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenAI — Secretario IA
# La API key NO va aquí: vive como secreto de la Edge Function openai-proxy.
# Configurarla con: supabase secrets set OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=1024
ASSISTANT_MAX_REACT_ITERATIONS=6
ASSISTANT_HISTORY_TURNS=12
